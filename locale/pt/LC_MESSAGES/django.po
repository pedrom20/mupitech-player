msgstr "Pedido inválido — MupiTech"

msgid "Bad request"
msgstr "Pedido inválido"

msgid "The server couldn't understand that request. Try going back and re-submitting."
msgstr "O servidor não conseguiu entender o pedido. Volte atrás e tente novamente."

msgid "Forbidden — MupiTech"
msgstr "Acesso negado — MupiTech"

msgid "You can't access this page"
msgstr "Não tem acesso a esta página"

msgid "This URL is restricted — by an IP allow-list, an internal-auth check, or a permission boundary. Contact your operator if you believe this is wrong."
msgstr "Este endereço está restrito — por uma lista de IPs permitidos, uma verificação interna de autenticação, ou um limite de permissões. Contacte o seu operador se acha que isto está errado."

msgid "Page not found — MupiTech"
msgstr "Página não encontrada — MupiTech"

msgid "Page not found"
msgstr "Página não encontrada"

msgid "The page you were looking for has moved, been removed, or never existed."
msgstr "A página que procurava foi movida, removida, ou nunca existiu."

msgid "Server error — MupiTech"
msgstr "Erro do servidor — MupiTech"

msgid "Something broke on our end"
msgstr "Algo correu mal do nosso lado"

msgid "The server hit an unexpected error. Try reloading; if it persists, check the device logs."
msgstr "O servidor teve um erro inesperado. Tente recarregar a página; se persistir, verifique os registos do dispositivo."

msgid "Session expired — MupiTech"
msgstr "Sessão expirada — MupiTech"

msgid "Your session expired"
msgstr "A sua sessão expirou"

msgid "The form's security token didn't match. Reload the page and try again."
msgstr "O token de segurança do formulário não corresponde. Recarregue a página e tente novamente."

